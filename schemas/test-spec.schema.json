{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nitmi/embedded-agent-toolkit/schemas/test-spec.schema.json",
  "title": "Embedded Agent Toolkit Hardware Test Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "selection",
    "debug_target",
    "resources",
    "stages",
    "assertions",
    "cleanup"
  ],
  "properties": {
    "schema_version": {"const": "embedded-agent-toolkit.test-spec.v1"},
    "name": {"$ref": "#/$defs/id"},
    "selection": {"type": "string", "minLength": 1},
    "debug_target": {"type": ["string", "null"], "minLength": 1},
    "resources": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/resource"}
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/stage"}
    },
    "assertions": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/assertion"}
    },
    "cleanup": {
      "type": "array",
      "maxItems": 4,
      "items": {"$ref": "#/$defs/cleanup"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {
          "enum": [
            "firmware",
            "baud-workflow",
            "blea-workflow",
            "debugger-runtime-contract"
          ]
        },
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "operation": {
      "enum": [
        "baud.monitor",
        "baud.workflow",
        "blea.scan",
        "blea.workflow",
        "embedded-debugger.probes-test",
        "embedded-debugger.flash-plan",
        "embedded-debugger.flash-execute",
        "embedded-debugger.runtime-inspect",
        "embedded-debugger.runtime-accept"
      ]
    },
    "effect": {
      "enum": [
        "host_process_start",
        "hardware_discovery",
        "serial_open",
        "serial_transmit",
        "ble_scan",
        "ble_connect",
        "ble_write",
        "debug_attach",
        "target_state_may_change",
        "target_reset",
        "target_halt",
        "target_resume",
        "target_step",
        "register_read",
        "register_write",
        "memory_read",
        "memory_write",
        "flash_erase",
        "flash_write",
        "recover",
        "external_actuation"
      ]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operation",
        "inputs",
        "requires",
        "declared_effects",
        "timeout_seconds",
        "max_retries",
        "evidence_output"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "operation": {"$ref": "#/$defs/operation"},
        "inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "declared_effects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/effect"}
        },
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "max_retries": {"type": "integer", "minimum": 0, "maximum": 3},
        "evidence_output": {"type": "string", "minLength": 1}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stage", "json_pointer", "operator", "expected"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "stage": {"$ref": "#/$defs/id"},
        "json_pointer": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
        },
        "operator": {
          "enum": ["equals", "not_equals", "at_least", "at_most", "contains"]
        },
        "expected": {"type": ["string", "number", "integer", "boolean", "null"]}
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "required_state", "timeout_seconds"],
      "properties": {
        "resource": {"enum": ["serial", "ble", "debug", "target"]},
        "required_state": {
          "enum": ["closed", "disconnected", "running", "halted", "unchanged"]
        },
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    }
  }
}
